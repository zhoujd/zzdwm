#!/bin/sh

FIFO="${DVTM_CMD_FIFO:-/tmp/dvtm-command.fifo}"

if [ $# -lt 1 ]; then
    echo "Usage: dvtm-cmd <action> [command/args]" >&2
    echo "Example: dvtm-cmd create \"me build.sh\"" >&2
    echo "Example: dvtm-cmd cstack me build.sh" >&2
    exit 1
fi

if [ ! -p "$FIFO" ]; then
    echo "Error: FIFO $FIFO not found." >&2
    exit 1
fi

# Function to format 'create' and 'cstack' commands cleanly
format_create_cmd() {
    action="$1"
    cmd="$2"

    # No arguments (e.g. opens default shell)
    if [ -z "$cmd" ]; then
        printf '%s\n' "$action"
        return
    fi

    # Single command without file args (e.g. "htop" or "zsh")
    case "$cmd" in
        *" "*) ;; # Has arguments, continue below
        *) printf "%s '%s'\n" "$action" "$cmd"; return ;;
    esac

    # Command with arguments (e.g. "me file.c")
    bin="${cmd%% *}"
    args="${cmd#* }"

    case "$args" in
        /*|~/*|~) printf "%s '%s %s'\n" "$action" "$bin" "$args" ;;
        *)        printf "%s '%s -d %s %s'\n" "$action" "$bin" "$PWD" "$args" ;;
    esac
}

ACTION="$1"
shift
CMD="$*"

# Main execution dispatch
case "$ACTION" in
    create|cstack) format_create_cmd "$ACTION" "$CMD" > "$FIFO" ;;
    *)             printf "%s '%s'\n" "$ACTION" "$CMD" > "$FIFO" ;;
esac
