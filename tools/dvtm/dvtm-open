#!/bin/sh

if [ $# -lt 1 ] || [ -z "$1" ]; then
    echo "Usage: $(basename "$0") <file_path>" >&2
    exit 1
fi

FILE_PATH="$1"

if [ -f "$FILE_PATH" ]; then
    if [ -n "$DVTM" ]; then
        dvtm-cmd cstack me "${FILE_PATH}"
    else
        me "$FILE_PATH"
    fi
else
    xdg-open "$FILE_PATH" 2>/dev/null &
fi
