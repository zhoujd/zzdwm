# Makefile - makefile input file for MicroEMACS.

# The top-level source directory.

srcdir = .

# Directories containing system- and tty-specific source.

TTY = ./tty/mingw
SYS = ./sys/mingw
VPATH = $(SYS):$(TTY)
INC = -I$(srcdir) -I$(SYS) -I$(TTY)

COLOR ?= yes
LISP ?= yes
AI ?= no
COLOR_FLAG := $(if $(filter yes,$(COLOR)),-DCOLOR,)
LISP_FLAG := $(if $(filter yes,$(LISP)),-DLISP,)
AI_FLAG :=
AI_OBJ :=
ifeq ($(AI), yes)
ifeq ($(LISP), no)
$(error AI=yes requires LISP=yes)
endif
AI_FLAG := -DAI
AI_OBJ := ai.o
endif

# Compilers, linkers, and their flags.

CC = gcc
CFLAGS = -std=c99 -D_POSIX_C_SOURCE=200809L -DMINGW -DBACKUP \
         $(COLOR_FLAG) $(LISP_FLAG) $(AI_FLAG) $(INC) \
         -Wall -Wextra -pedantic \
         -Wno-unused-parameter \
         -Wno-implicit-fallthrough
ifeq ($(DEBUG), yes)
CFLAGS := -g -O0 $(CFLAGS)
else
CFLAGS := -Os $(CFLAGS)
endif

LD = gcc
LDFLAGS := -s $(LDFLAGS)
LIBS = -lkernel32 -lntdll -lmsvcrt
ifeq ($(AI), yes)
LIBS += -lws2_32
endif

BUILD_FLAGS = $(CC) $(CFLAGS) $(LD) $(LDFLAGS) $(LIBS)
BUILD_FLAGS_FILE = .build-flags

# Objects comprising MicroEMACS.

LISP_OBJ :=
ifeq ($(LISP), yes)
LISP_OBJ := lisp.o tinylisp.o
endif

OBJ := \
	basic.o \
	buffer.o \
	cinfo.o \
	cscope.o \
	display.o \
	echo.o \
	extend.o \
	file.o \
	kbd.o \
	line.o \
	$(LISP_OBJ) \
	$(AI_OBJ) \
	main.o \
	paragraph.o \
	random.o \
	regexp.o \
	region.o \
	regsub.o \
	ring.o \
	search.o \
	spell.o \
	symbol.o \
	syntax.o \
	version.o \
	window.o \
	word.o \
	fileio.o \
	spawn.o \
	tags.o \
	ttyio.o \
	tty.o \
	ttykbd.o \
	undo.o \
	utf8.o \
	complete.o \
	bufmenu.o \
	error.o

$(BUILD_FLAGS_FILE): FORCE
	@printf '%s\n' '$(BUILD_FLAGS)' > $@.tmp
	@if cmp -s $@.tmp $@; then \
	  rm -f $@.tmp; \
	else \
	  mv -f $@.tmp $@; \
	fi

# How to compile a module.

.c.o:
	$(CC) -c $(CFLAGS) $<

# How to link MicroEMACS.

TARGET = me.exe
REV = rev.h

$(TARGET): $(OBJ)
	$(LD) -o $@ $(LDFLAGS) $(OBJ) $(LIBS)

$(OBJ): $(BUILD_FLAGS_FILE)

lisp.o: lisp.c
	$(CC) -c $(CFLAGS) -fno-asynchronous-unwind-tables $<

tinylisp.o: tinylisp.c tinylisp.h
	$(CC) -c $(CFLAGS) -std=c11 -fno-asynchronous-unwind-tables $<

$(REV):
	@$(srcdir)/ver.sh $@

version.o: $(REV)

strip: $(TARGET)
	strip -v $(TARGET)

clean:
	rm -f *.[o] $(TARGET) $(REV) $(BUILD_FLAGS_FILE) \
	      $(BUILD_FLAGS_FILE).tmp

FORCE:

.PHONY: FORCE
