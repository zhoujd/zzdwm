# Makefile - makefile input file for MicroEMACS.

# The top-level source directory.

srcdir = .

# Directories containing system- and tty-specific source.

ifeq ($(TERMCAP), yes)
TTY = ./tty/termcap
else
TTY = ./tty/ncurses
endif
SYS = ./sys/unix
VPATH = $(SYS):$(TTY)
INC = -I$(srcdir) -I$(SYS) -I$(TTY)

COLOR ?= yes
LISP ?= yes
AI ?= yes
MOUSE ?= yes
MINIMAL ?= no
COLOR_FLAG := $(if $(filter yes,$(COLOR)),-DCOLOR,)
LISP_FLAG := $(if $(filter yes,$(LISP)),-DLISP,)
MOUSE_FLAG := $(if $(filter yes,$(MOUSE)),-DMOUSE,)
MINIMAL_FLAG := $(if $(filter yes,$(MINIMAL)),-DMINIMAL,)
AI_FLAG :=
AI_OBJ :=
ifeq ($(AI), yes)
ifeq ($(LISP), no)
$(error AI=yes requires LISP=yes)
endif
AI_FLAG := -DAI
AI_OBJ := ai.o
endif

# Compilers, linkers, and their flags.

CC = gcc
CFLAGS = -std=c99 -D_GNU_SOURCE -DLINUX -DBACKUP \
         $(COLOR_FLAG) $(LISP_FLAG) $(MOUSE_FLAG) $(MINIMAL_FLAG) \
         $(AI_FLAG) $(INC) \
         -Wall -Wextra -pedantic \
         -Wno-unused-parameter \
         -Wno-implicit-fallthrough
ifeq ($(DEBUG), yes)
CFLAGS := -g -O0 $(CFLAGS)
else
CFLAGS := -Os -ffunction-sections -fdata-sections \
          -fno-asynchronous-unwind-tables $(CFLAGS)
endif

LD = gcc
LDFLAGS =
ifeq ($(STATIC), yes)
LDFLAGS := -static -Wl,--gc-sections -Wl,-z,noseparate-code $(LDFLAGS)
endif
ifeq ($(TERMCAP), yes)
LIBS = -ltermcap
else
LIBS = -lncursesw
endif

BUILD_FLAGS = $(CC) $(CFLAGS) $(LD) $(LDFLAGS) $(LIBS)
BUILD_FLAGS_FILE = .build-flags

# Objects comprising MicroEMACS.

LISP_OBJ :=
ifeq ($(LISP), yes)
LISP_OBJ := lisp.o tinylisp.o
endif

MOUSE_OBJ :=
ifeq ($(MOUSE), yes)
MOUSE_OBJ := mouse.o
endif

OBJ := \
	basic.o \
	buffer.o \
	cinfo.o \
	cscope.o \
	display.o \
	echo.o \
	extend.o \
	file.o \
	help.o \
	kbd.o \
	line.o \
	$(LISP_OBJ) \
	$(AI_OBJ) \
	main.o \
	$(MOUSE_OBJ) \
	paragraph.o \
	random.o \
	regexp.o \
	region.o \
	regsub.o \
	ring.o \
	search.o \
	spell.o \
	symbol.o \
	syntax.o \
	version.o \
	window.o \
	word.o \
	path.o \
	fileio.o \
	spawn.o \
	tags.o \
	ttyio.o \
	tty.o \
	ttykbd.o \
	undo.o \
	utf8.o \
	complete.o \
	bufmenu.o \
	error.o

$(BUILD_FLAGS_FILE): FORCE
	@printf '%s\n' '$(BUILD_FLAGS)' > $@.tmp
	@if cmp -s $@.tmp $@; then \
	  rm -f $@.tmp; \
	else \
	  mv -f $@.tmp $@; \
	fi

# How to compile a module.

.c.o:
	$(CC) -c $(CFLAGS) $<

# How to link MicroEMACS.

TARGET = me
PREFIX = /usr/local
DEST = $(PREFIX)/bin/$(TARGET)
REV = rev.h

$(TARGET): $(OBJ)
	$(LD) -o $@ $(LDFLAGS) $(OBJ) $(LIBS)

$(OBJ): $(BUILD_FLAGS_FILE)

$(REV):
	@$(srcdir)/ver.sh $@

version.o: $(REV)

tinylisp.o: tinylisp.c tinylisp.h
	$(CC) -c $(CFLAGS) -std=c11 -fno-asynchronous-unwind-tables $<

strip: $(TARGET)
	strip -v $(TARGET)

install:
	cp -f $(TARGET) $(DEST)

uninstall:
	rm -f $(DEST)

clean:
	rm -f *.[o] $(TARGET) $(REV) $(BUILD_FLAGS_FILE) \
	      $(BUILD_FLAGS_FILE).tmp

FORCE:

.PHONY: FORCE
