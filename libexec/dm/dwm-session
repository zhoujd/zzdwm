#!/bin/bash
# Autostart launcher and session wrapper for dwm

log="$HOME/.dwm-errors"
kind="${1:-run}"

# Autostart applications list
opt=(
    "VBoxClient-all"
)

log_msg() {
    echo "[$$ | $(date '+%Y-%m-%d %H:%M:%S.%N')] $1"
}

spawn() {
    for cmd in "${opt[@]}"; do
        app=$(echo "$cmd" | awk '{print $1}')
        if command -v "$app" >/dev/null 2>&1; then
            log_msg "[spawn] Running $cmd"
            $cmd >/dev/null 2>&1 &
        else
            log_msg "[spawn] Warning: $app not found, skipping."
        fi
    done
}

run_session() {
    log_msg "[dwm] Starting dwm in run mode."
    spawn
    exec dwm >/dev/null 2>&1
}

debug_session() {
    log_msg "[dwm] Starting dwm in debug mode."
    spawn
    exec dwm
}

# Append to log file rather than overwriting
exec >> "$log" 2>&1

case "$kind" in
    run|-r )
        run_session
        ;;
    debug|-d )
        debug_session
        ;;
    * )
        echo "Usage: $(basename "$0") [run|-r|debug|-d]"
        exit 1
        ;;
esac
