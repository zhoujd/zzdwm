#!/bin/bash
# Run-or-Raise: Focus an app by class, or launch it if not running

if [ "$#" -lt 1 ]; then
    echo "Usage: $(basename "$0") {app_class} [launch_cmd]"
    exit 1
fi

app="$1"
cmd="${2:-$app}"

# Get active window ID in standard 8-digit hex format
active_win_id=$(xprop -root _NET_ACTIVE_WINDOW 2>/dev/null | awk '{print $NF}')
[ "$active_win_id" = "0x0" ] && active_win_id=""
[ -n "$active_win_id" ] && active_win_id=$(printf "0x%08x" "$active_win_id")

# Find all windows matching the requested class (case-insensitive)
win_list=($(wmctrl -xl 2>/dev/null | awk -v app="$app" '
    tolower($3) ~ tolower(app) { print $1 }
'))

# If no windows are found, launch the command
if [ "${#win_list[@]}" -eq 0 ]; then
    if command -v "$cmd" >/dev/null 2>&1; then
        nohup "$cmd" >/dev/null 2>&1 &
        exit 0
    else
        echo "Error: Command '$cmd' not found in PATH." >&2
        exit 1
    fi
fi

# Find target window to focus
switch_to=""
total=${#win_list[@]}

for i in "${!win_list[@]}"; do
    if [ "$(printf "0x%08x" "${win_list[$i]}")" = "$active_win_id" ]; then
        next_idx=$(( (i + 1) % total ))
        switch_to="${win_list[$next_idx]}"
        break
    fi
done

# If current active window is not in the list, focus the first window found
if [ -z "$switch_to" ]; then
    switch_to="${win_list[0]}"
fi

# Focus the target window
wmctrl -i -a "$switch_to"
