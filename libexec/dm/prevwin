#!/bin/bash
# Previous window of same application ON ALL DESKTOPS

# Get active window ID & normalize to lowercase 8-digit padded hex
active_win_id=$(xprop -root _NET_ACTIVE_WINDOW 2>/dev/null | awk '{print $NF}')
[ "$active_win_id" = "0x0" ] || [ -z "$active_win_id" ] && exit 0

clean_active=$(echo "$active_win_id" | sed 's/^0x//')
active_win_id=$(printf "0x%08x" "0x$clean_active" 2>/dev/null | tr '[:upper:]' '[:lower:]')

# Get window class of current active window (case-insensitive ID match)
win_class=$(wmctrl -xl 2>/dev/null | awk -v id="$active_win_id" 'tolower($1) == id {print $3}')

if [ -n "$win_class" ]; then
    # Fetch matching window IDs across ALL desktops
    mapfile -t win_list < <(wmctrl -xl 2>/dev/null | awk -v cls="$win_class" '$3 == cls {print $1}')

    total=${#win_list[@]}
    [ "$total" -le 1 ] && exit 0  # Only 1 window open globally, do nothing

    # Locate current index and select previous window in cycle
    switch_to=""
    for i in "${!win_list[@]}"; do
        clean_win=$(echo "${win_list[$i]}" | sed 's/^0x//')
        norm_win=$(printf "0x%08x" "0x$clean_win" 2>/dev/null | tr '[:upper:]' '[:lower:]')

        if [ "$norm_win" = "$active_win_id" ]; then
            prev_idx=$(( (i - 1 + total) % total ))
            switch_to="${win_list[$prev_idx]}"
            break
        fi
    done

    # Switch focus
    if [ -n "$switch_to" ]; then
        wmctrl -i -a "$switch_to"
    fi
fi
