#!/bin/sh
# Context-aware terminal spawner (Flat, Guarded Structure)

# Default terminal command fallback
TERM_CMD="st"

# Get active window ID (Exit early if no window active)
WIN_ID=$(xprop -root _NET_ACTIVE_WINDOW 2>/dev/null | awk '{print $NF}')
[ -z "$WIN_ID" ] || [ "$WIN_ID" = "0x0" ] && exec $TERM_CMD

# Auto-detect if current window is st or urxvt
WIN_CLASS=$(xprop -id "$WIN_ID" WM_CLASS 2>/dev/null | awk -F '"' '{print tolower($4)}')
case "$WIN_CLASS" in
    urxvt*|rxvt* )
        TERM_CMD="urxvt"
        DIR_FLAG="-cd"
        ;;
    st* )
        TERM_CMD="st"
        DIR_FLAG="-d"
        ;;
    * )
        DIR_FLAG="-d"
        ;;
esac

# Get PID (Exit early if no PID found)
PID=$(xprop -id "$WIN_ID" _NET_WM_PID 2>/dev/null | awk '{print $NF}')
echo "$PID" | grep -qE '^[0-9]+$' || exec $TERM_CMD

# Find leaf child process PID in tree
CHILD_PID=$(pstree -lpA "$PID" 2>/dev/null | tail -n 1 | awk -F'---' '{print $NF}' | sed -re 's/[^0-9]//g')
[ -n "$CHILD_PID" ] && PID="$CHILD_PID"

# Extract CWD and Command Context
[ -d "/proc/$PID/cwd" ] && PCWD=$(readlink "/proc/$PID/cwd" 2>/dev/null)

if [ -f "/proc/$PID/cmdline" ]; then
    PCMDLINE=$(tr '\0' ' ' < "/proc/$PID/cmdline" 2>/dev/null | sed -e 's/[[:space:]]*$//')
    PCMD=$(echo "$PCMDLINE" | awk '{print $1}')
fi

# Execute based on context
case "$PCMD" in
    ssh|*/ssh )
        case $TERM_CMD in
            st* ) TERM_CMD="$TERM_CMD -x" ;;
        esac
        [ -n "$PCMDLINE" ] && exec $TERM_CMD -e $PCMDLINE
        ;;
    * )
        [ -d "$PCWD" ] && exec $TERM_CMD $DIR_FLAG "$PCWD"
        ;;
esac

# Fallback default spawn
exec $TERM_CMD
