#!/bin/bash
# Next window of same application

# Get active window ID (standardized hex format)
active_win_id=$(xprop -root _NET_ACTIVE_WINDOW 2>/dev/null | awk '{print $NF}')
[ "$active_win_id" = "0x0" ] || [ -z "$active_win_id" ] && exit 0

clean_active=$(echo "$active_win_id" | sed 's/^0x//')
active_win_id=$(printf "0x%08x" "0x$clean_active" 2>/dev/null)

# Find the exact WM_CLASS of the active window
win_class=$(wmctrl -xl | awk -v id="$active_win_id" 'tolower($1) == id {print $3}')

if [ -n "$win_class" ]; then
    # Get ordered list of window IDs belonging to this class
    win_list=($(wmctrl -xl | awk -v cls="$win_class" '$3 == cls {print $1}'))

    # Locate current window index and calculate next index
    for i in "${!win_list[@]}"; do
        if [ "$(printf "0x%08x" "${win_list[$i]}")" = "$active_win_id" ]; then
            next_idx=$(( (i + 1) % ${#win_list[@]} ))
            switch_to="${win_list[$next_idx]}"
            break
        fi
    done

    # Switch focus
    if [ -n "$switch_to" ]; then
        wmctrl -i -a "$switch_to"
    fi
fi
