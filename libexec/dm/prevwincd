#!/bin/bash
# Previous window of same application ON CURRENT DESKTOP ONLY

# Get active window ID (standardized hex format)
active_win_id=$(xprop -root _NET_ACTIVE_WINDOW | awk '{print $NF}')

if [ "$active_win_id" = "0x0" ] || [ -z "$active_win_id" ]; then
    exit 0
fi

active_win_id=$(printf "0x%08x" "$active_win_id")

# Get active desktop index
current_desktop=$(xdotool get_desktop)

# Get window class of current active window
win_class=$(wmctrl -xl | awk -v id="$active_win_id" 'tolower($1) == id {print $3}')

if [ -n "$win_class" ]; then
    # Fetch matching window IDs ONLY on current desktop (or sticky desktop -1)
    win_list=($(wmctrl -xl | awk -v cls="$win_class" -v desk="$current_desktop" \
      '$3 == cls && ($2 == desk || $2 == -1) {print $1}'))

    total=${#win_list[@]}

    # Locate active index and step backward
    for i in "${!win_list[@]}"; do
        if [ "$(printf "0x%08x" "${win_list[$i]}")" = "$active_win_id" ]; then
            prev_idx=$(( (i - 1 + total) % total ))
            switch_to="${win_list[$prev_idx]}"
            break
        fi
    done

    # Switch focus
    if [ -n "$switch_to" ]; then
        wmctrl -i -a "$switch_to"
    fi
fi
