#!/bin/bash
# Previous window of same application ON CURRENT DESKTOP ONLY

# Get active window ID (standardized hex format)
active_win_id=$(xprop -root _NET_ACTIVE_WINDOW 2>/dev/null | awk '{print $NF}')
[ "$active_win_id" = "0x0" ] || [ -z "$active_win_id" ] && exit 0

clean_active=$(echo "$active_win_id" | sed 's/^0x//')
active_win_id=$(printf "0x%08x" "0x$clean_active" 2>/dev/null | tr '[:upper:]' '[:lower:]')

# Get active desktop index
current_desktop=$(xprop -root _NET_CURRENT_DESKTOP 2>/dev/null | awk '{print $NF}')
[ -z "$current_desktop" ] && current_desktop="0"

# Get window class of current active window
win_class=$(wmctrl -xl 2>/dev/null | awk -v id="$active_win_id" 'tolower($1) == id {print $3}')

if [ -n "$win_class" ]; then
    # Fetch matching window IDs ONLY on current desktop (or sticky desktop -1)
    mapfile -t win_list < <(wmctrl -xl 2>/dev/null | awk -v cls="$win_class" -v desk="$current_desktop" \
      '$3 == cls && ($2 == desk || $2 == -1) {print $1}')

    total=${#win_list[@]}
    [ "$total" -le 1 ] && exit 0

    # Locate active index and step backward
    for i in "${!win_list[@]}"; do
        clean_win=$(echo "${win_list[$i]}" | sed 's/^0x//')
        norm_win=$(printf "0x%08x" "0x$clean_win" 2>/dev/null | tr '[:upper:]' '[:lower:]')
        if [ "$norm_win" = "$active_win_id" ]; then
            prev_idx=$(( (i - 1 + total) % total ))
            switch_to="${win_list[$prev_idx]}"
            break
        fi
    done

    # Switch focus
    if [ -n "$switch_to" ]; then
        wmctrl -i -a "$switch_to"
    fi
fi
