#!/usr/bin/env python3
import sys
from pathlib import Path

patch_file = Path(sys.argv[1]) if len(sys.argv) > 1 else None
lines = (patch_file.read_text() if patch_file else sys.stdin.read()).splitlines()
if not lines or lines[0] != "*** Begin Patch" or lines[-1] != "*** End Patch":
    raise SystemExit("invalid patch")
index = 1
while index < len(lines) - 1:
    section = lines[index]
    kind, _, raw_path = section.partition(": ")
    index += 1
    if kind == "*** Add File":
        path = Path(raw_path)
        if path.exists():
            raise SystemExit(f"file already exists: {path}")
        content = []
        while index < len(lines) and not lines[index].startswith("*** "):
            if not lines[index].startswith("+"):
                raise SystemExit(f"invalid add line: {lines[index]}")
            content.append(lines[index][1:])
            index += 1
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text("\n".join(content) + "\n")
    elif kind == "*** Update File":
        hunk = []
        while index < len(lines) and not lines[index].startswith("*** "):
            hunk.append(lines[index])
            index += 1
        if not hunk or not hunk[0].startswith("@@"):
            raise SystemExit(f"invalid hunk in {raw_path}")
        old, new = [], []
        for line in hunk[1:]:
            if line.startswith("-"):
                old.append(line[1:])
            elif line.startswith("+"):
                new.append(line[1:])
            elif line.startswith(" "):
                old.append(line[1:])
                new.append(line[1:])
            else:
                raise SystemExit(f"invalid patch line: {line}")
        path = Path(raw_path)
        content = path.read_text().splitlines()
        matches = [start for start in range(len(content) - len(old) + 1)
                   if content[start:start + len(old)] == old]
        if len(matches) != 1:
            raise SystemExit(f"hunk did not match uniquely in {path}: {matches}")
        start = matches[0]
        content[start:start + len(old)] = new
        path.write_text("\n".join(content) + "\n")
    else:
        raise SystemExit(f"unsupported section: {section}")
