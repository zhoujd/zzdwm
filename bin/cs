#!/bin/bash

# Define MicroEMACS as the default editor
EDITOR=${EDITOR:-me}

# Default color is red if CS_COLOR is not set.
# Supported shorthand: red, green, yellow, blue, magenta, cyan
case "${CS_COLOR,,}" in
    green )   export GREP_COLORS="ms=01;32" ;; # Bold Green
    yellow )  export GREP_COLORS="ms=01;33" ;; # Bold Yellow
    blue )    export GREP_COLORS="ms=01;34" ;; # Bold Blue
    magenta ) export GREP_COLORS="ms=01;35" ;; # Bold Magenta
    cyan )    export GREP_COLORS="ms=01;36" ;; # Bold Cyan
    red|* )   export GREP_COLORS="ms=01;31" ;; # Bold Red (Default)
esac

# Check if terminal supports color and stdout is an interactive TTY
supports_color() {
    # Respect the NO_COLOR standard (https://no-color.org)
    [ -n "${NO_COLOR}" ] && return 1
    # Return false if stdout is piped or redirected (e.g., into MicroEMACS)
    [ ! -t 1 ] && return 1
    # GNU Emacs subshells set INSIDE_EMACS or EMACS and process ANSI color codes
    if [ -n "${INSIDE_EMACS}" ] || [ -n "${EMACS}" ]; then
        return 0
    fi
    # Check for non-Emacs dumb terminal environments
    if [ "${TERM}" = "dumb" ]; then
        return 1
    fi
    # Check tput colors capability if available
    if command -v tput >/dev/null 2>&1; then
        local ncolors
        ncolors=$(tput colors 2>/dev/null)
        if [ -n "$ncolors" ] && [ "$ncolors" -ge 8 ]; then
            return 0
        else
            return 1
        fi
    fi
    return 0
}

# Disable color if stdout is piped or the terminal does not support it
if ! supports_color; then
    GREP_COLOR_FLAG="--color=never"
else
    GREP_COLOR_FLAG="--color=always"
fi

# Function to print usage information
usage() {
    local app=$(basename $0)
    cat <<EOF
Usage:
$ $app {n} {text/file} [-p]  - Search code (optional -p to pick & open)
$ $app h {symbol}            - Show function header via ref tool
$ $app r | --rebuild         - Force rebuild cscope and ctags/etags tags
$ $app c | --clean           - Clean up generated index files

Environment Variables:
CS_COLOR=color  - Control highlight color (red, green, yellow, blue, magenta, cyan)
                  Example: CS_COLOR=green cs 5 main

The list of possible values for {n}
0: Find this C symbol
1: Find this definition
2: Find functions called by this function
3: Find functions calling this function
4: Find this text string
5: List functions/definitions using ctags
e: List functions/definitions using TAGS (etags format)
6: Find this egrep pattern
7: Find this file
8: Find files #including this file
9: Find places where this symbol is assigned a value
EOF
}

# Function to clean up cscope files in the current directory
clean_cscope() {
    rm -f ./cscope.files ./cscope.out ./cscope.in.out ./cscope.po.out
}

# Function to clean up ctags and etags files in the current directory
clean_tags() {
    rm -f ./tags ./TAGS
}

# Function to force a fresh rebuild of cscope databases
rebuild_cscope() {
    # Find C/C++ source and header files while excluding the build directory
    find . -type f \
        \( -path "./build" -o -path "./dist" \) -prune -o \
        \( -name "*.[ch]" -o -name "*.cpp" -o -name "*.hpp" \) \
        -print > cscope.files
    # Build cscope index using the generated cscope.files list
    cscope -bRq -i cscope.files
}

# Function to force a fresh rebuild ctags databases
rebuild_ctags() {
    # Rebuild ctags
    ctags -u --exclude=build --exclude=dist -R . 2>/dev/null
}

# Function to force a fresh rebuild of the etags-format TAGS database.
# ctags emits explicit tag names, which GNU etags omits for C functions.
rebuild_etags() {
    ctags -e -u --exclude=build --exclude=dist -R . 2>/dev/null
}

# Reshapes etags-format TAGS lines into 'file:line: <symbol> code' format.
format_etags() {
    awk '
        /^\f/ {
            file = ""
            in_file = 0
            next
        }
        !in_file {
            file = $0
            sub(/,[0-9]+$/, "", file)
            if (file == "")
                next
            in_file = 1
            next
        }
        {
            tag_start = index($0, "\177")
            if (tag_start == 0)
                next

            code = substr($0, 1, tag_start - 1)
            location = substr($0, tag_start + 1)
            symbol = ""

            symbol_end = index(location, "\001")
            if (symbol_end > 0) {
                symbol = substr(location, 1, symbol_end - 1)
                location = substr(location, symbol_end + 1)
            }

            comma = index(location, ",")
            if (comma == 0)
                next

            line = substr(location, 1, comma - 1)
            if (line !~ /^[0-9]+\r?$/)
                next

            sub(/\r$/, "", line)
            sub(/[[:space:]]+$/, "", symbol)

            print file ":" line ": <" symbol "> " code
        }'
}

# Reshapes 'ctags -x' into 'file:line: <symbol> code' format.
# Passes through lines unchanged if they are already formatted or unrecognized
format_ctags() {
    awk '{
        # Save original line for passthrough fallback
        orig = $0;

        # Standard 4-column output check: $3 is line number, $4 is filename/path
        if ($3 ~ /^[0-9]+$/ && $4 ~ /[^ ]+/) {
            sym = $1; line = $3; file = $4;
            $1 = $2 = $3 = $4 = "";
            sub(/^[ \t]+/, "");
            printf "%s:%s: <%s> %s\n", file, line, sym, $0;
            next;
        }

        # Extended/Section tag check (e.g. Markdown headers)
        line = ""; file = "";
        for (i = 2; i <= NF; i++) {
            if ($i ~ /^[0-9]+$/ && (i + 1) <= NF && $(i+1) ~ /[^ ]+/) {
                sym = $1; line = $i; file = $(i+1);
                for (j = 1; j <= i + 1; j++) $j = "";
                sub(/^[ \t]+/, "");
                printf "%s:%s: <%s> %s\n", file, line, sym, $0;
                next;
            }
        }

        # Fallback passthrough for any other format or blank lines
        print orig;
    }'
}

# Reshapes native 'cscope' into 'file:line: <func> code' format.
format_cscope() {
    awk '{
        file=$1; func_name=$2; line=$3;
        $1=$2=$3=""; sub(/^[ \t]+/, "");
        printf "%s:%s <%s> %s\n", file, line, func_name, $0
    }'
}

# Extracts the file and line fields from a formatted picker match.
pick_open() {
    local file line
    if [[ $1 =~ ^(.+):([0-9]+) ]]; then
        file=${BASH_REMATCH[1]}
        line=${BASH_REMATCH[2]}
    else
        file=
        line=
    fi
    if [ -n "$file" ] && [ -n "$line" ]; then
        echo "Opening $file at line $line in MicroEMACS..."
        exec "$EDITOR" +"$line" "$file"
    fi
}

# Check for immediate control flags
if [ "$1" == "c" ] || [ "$1" == "--clean" ]; then
    echo "Cleaning up cscope index files in the current directory..."
    clean_cscope
    echo "Cleaning up ctags and etags index files in the current directory..."
    clean_tags
    echo "Done."
    exit 0
elif [ "$1" == "r" ] || [ "$1" == "--rebuild" ]; then
    echo "Rebuilding cscope indexes in the current directory..."
    rebuild_cscope
    echo "Rebuilding ctags indexes in the current directory..."
    rebuild_ctags
    echo "Rebuilding etags index in the current directory..."
    rebuild_etags
    echo "Done."
    exit 0
fi

# Determine if the user wants to use 'pick' via the 3rd argument
USE_PICK=0
if [ "$3" == "-p" ]; then
    USE_PICK=1
fi

# Check if the correct number of arguments is provided for searching
if [ $# -lt 2 ] || [ $# -gt 3 ]; then
    usage
    exit 1
fi

# Only allow exactly 0-9, 'e', and 'h' as the first parameter
if [[ ! "$1" =~ ^[0-9eh]$ ]]; then
    echo "Error: Unrecognized option '$1'."
    echo ""
    usage
    exit 1
fi

# Function to search upward from the current directory for a specific file
search_up() {
    local look=${PWD%/}
    while [[ -n $look ]]; do
        [[ -e $look/$1 ]] && { printf '%s\n' "$look"; return; }
        look=${look%/*}
    done
    [[ -e /$1 ]] && echo /
}

# Handle option 'h' early to show function headers using ref
if [ "${1}" == "h" ]; then
    echo "Locating function header for '${2}'..."
    # Resolve the tags file location to feed into ref -p
    SEARCH_TAGS=$(search_up "tags")

    # Check if tags exists and convert it to an ABSOLUTE path to avoid sub-dir bugs
    if [ -n "$SEARCH_TAGS" ] && [ -f "$SEARCH_TAGS/tags" ]; then
        # Cd to the folder momentarily to get the full absolute path
        ABS_TAGS=$(cd "$SEARCH_TAGS" && pwd)/tags
        OUTPUT=$(ref -p "$ABS_TAGS" "${2}" 2>&1)
    else
        OUTPUT=$(ref "${2}" 2>&1)
    fi

    # Check if ref failed to find the tag, and offer smart helper info
    if echo "$OUTPUT" | grep -q "tag not found"; then
        echo "Error: 'ref' tool could not find the tag '${2}'."
        echo "Hint: Try running 'cs r' in your current project root directory"
        echo "      to rebuild the tags index, then try again."
        exit 1
    else
        echo "$OUTPUT" | grep $GREP_COLOR_FLAG -i -E "${2}|$"
    fi
    exit 0
fi

# Handle option 'e' since it relies on TAGS instead of cscope
if [ "${1}" == "e" ]; then
    SEARCH_ETAGS=$(search_up "TAGS")
    if [ -z "$SEARCH_ETAGS" ]; then
        echo "TAGS not found anywhere. Rebuilding in the current directory..."
        rebuild_etags
        if [ ! -f "./TAGS" ]; then
            echo "Error: No indexed source files found for TAGS."
            exit 1
        fi
        SEARCH_ETAGS=$PWD
    fi
    ETAGS_FILE="$SEARCH_ETAGS/TAGS"

    if [ $USE_PICK -eq 1 ]; then
        MATCH=$(format_etags < "$ETAGS_FILE" | grep -i -E "${2}" | pick)
        if [ -n "$MATCH" ]; then
            (cd "$SEARCH_ETAGS" && pick_open "$MATCH")
        fi
    else
        if [ -f "$SEARCH_ETAGS/${2}" ]; then
            echo "Listing functions/definitions in file: ${2}"
            format_etags < "$ETAGS_FILE" | grep $GREP_COLOR_FLAG -i -F "${2}"
        else
            echo "Searching TAGS for '${2}'..."
            format_etags < "$ETAGS_FILE" | grep $GREP_COLOR_FLAG -i -E "${2}"
        fi
    fi
    exit 0
fi

# Handle option 5 early since it relies on ctags instead of cscope
if [ "${1}" == "5" ]; then
    if [ $USE_PICK -eq 1 ]; then
        if [ -f "${2}" ]; then
            MATCH=$(ctags -u -x "${2}" 2>/dev/null | format_ctags | pick)
        else
            MATCH=$(ctags -u -R -x . 2>/dev/null | format_ctags | grep -i "${2}" | pick)
        fi
        if [ -n "$MATCH" ]; then
            pick_open "$MATCH"
        fi
    else
        if [ -f "${2}" ]; then
            echo "Listing functions/definitions in file: ${2}"
            # Formats single file output to 'file:line: symbol code'
            ctags -u -x "${2}" 2>/dev/null | format_ctags | grep $GREP_COLOR_FLAG -i -E "${2}|$"
        else
            echo "Searching for files matching '${2}' to list functions..."
            # Formats project recursive output to 'file:line: symbol code'
            ctags -u -R -x . 2>/dev/null | format_ctags | grep $GREP_COLOR_FLAG -i "${2}"
        fi
    fi
    exit 0
fi

# Try to find an existing cscope.out in the current directory or its parent
# directories. Keep the database directory so indexed paths can be opened
# relative to it when queries are run from a subdirectory.
SEARCH=$(search_up "cscope.out")

if [ -n "$SEARCH" ]; then
    TAG_FILE="$SEARCH/cscope.out"
elif [ -f "$HOME/.emacs.d/tags/cscope.out" ]; then
    TAG_FILE="$HOME/.emacs.d/tags/cscope.out"
else
    echo "cscope.out not found anywhere. Rebuild a new index in the current directory..."
    rebuild_cscope
    TAG_FILE="./cscope.out"
fi

echo "Use: $TAG_FILE"

# Execute query based on the pick flag control
if [ $USE_PICK -eq 1 ]; then
    MATCH=$(cscope -d -f "$TAG_FILE" -R -L${1} ${2} | format_cscope | pick)
    if [ -n "$MATCH" ]; then
        if [ -n "$SEARCH" ]; then
            (cd "$SEARCH" && pick_open "$MATCH")
        else
            pick_open "$MATCH"
        fi
    fi
else
    # Execute query, format output to Emacs buffer style, and apply highlighting
    if cscope -d -f "$TAG_FILE" -R -L${1} "${2}" | format_cscope | \
        grep $GREP_COLOR_FLAG -i -F "${2}"; then
        :
    elif [ "$1" = "6" ]; then
        cscope -d -f "$TAG_FILE" -R -L6 "${2}" | format_cscope | \
            grep $GREP_COLOR_FLAG -i -E "${2}"
    fi
fi
