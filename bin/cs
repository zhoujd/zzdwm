#!/bin/bash

# Define MicroEMACS as the default editor
EDITOR="me"

# Default color is red if CS_COLOR is not set.
# Supported shorthand: red, green, yellow, blue, magenta, cyan
case "${CS_COLOR,,}" in
    green)   export GREP_COLORS="ms=01;32" ;; # Bold Green
    yellow)  export GREP_COLORS="ms=01;33" ;; # Bold Yellow
    blue)    export GREP_COLORS="ms=01;34" ;; # Bold Blue
    magenta) export GREP_COLORS="ms=01;35" ;; # Bold Magenta
    cyan)    export GREP_COLORS="ms=01;36" ;; # Bold Cyan
    red|*)   export GREP_COLORS="ms=01;31" ;; # Bold Red (Default)
esac

# Function to print usage information
usage() {
    cat <<EOF
Usage: 
  $ $(basename $0) {n} {text/file} - Search code / List functions
  $ $(basename $0) a {symbol}      - Auto-open specific function/symbol in MicroEMACS
  $ $(basename $0) r               - Force rebuild cscope and ctags tags
  $ $(basename $0) -c | --clean    - Clean up cscope files in current directory

Environment Variables:
  CS_COLOR=color   - Control highlight color (red, green, yellow, blue, magenta, cyan)
                     Example: CS_COLOR=green cs 5 main

The list of possible values for {n}
0: Find this C symbol
1: Find this definition
2: Find functions called by this function
3: Find functions calling this function
4: Find this text string
5: List functions/definitions using ctags
6: Find this egrep pattern
7: Find this file
8: Find files #including this file
9: Find places where this symbol is assigned a value
EOF
}

# Function to clean up cscope files in the current directory
clean_cscope() {
    echo "Cleaning up cscope index files in the current directory..."
    rm -f ./cscope.out ./cscope.in.out ./cscope.po.out ./tags
    echo "Done."
    exit 0
}

# Function to force a fresh rebuild of both cscope and ctags databases
rebuild_tags() {
    echo "Rebuilding cscope and ctags indexes in the current directory..."
    cscope -bRq
    ctags -u -R .
    echo "Done."
    exit 0
}

# Reshapes 'ctags -x' into GNU Emacs 'file:line: <symbol> code' format
format_ctags() {
    awk '{
        sym=$1; line=$3; file=$4;
        $1=$2=$3=$4=""; sub(/^[ \t]+/, ""); 
        printf "%s:%s: <%s> %s\n", file, line, sym, $0
    }'
}

# Reshapes native 'cscope' into GNU Emacs 'file:line: <func> code' format
format_cscope() {
    awk '{
        file=$1; func_name=$2; line=$3;
        $1=$2=$3=""; sub(/^[ \t]+/, "");
        printf "%s:%s: <%s> %s\n", file, line, func_name, $0
    }'
}

# Check for immediate control flags
if [ "$1" == "-c" ] || [ "$1" == "--clean" ]; then
    clean_cscope
elif [ "$1" == "r" ] || [ "$1" == "--rebuild" ]; then
    rebuild_tags
fi

# Check if the correct number of arguments is provided for searching
if [ $# != 2 ]; then
    usage
    exit 1
fi

# Only allow exactly 0-9 or 'a' as the first parameter
if [[ ! "$1" =~ ^[0-9a]$ ]]; then
    echo "Error: Unrecognized option '$1'."
    echo ""
    usage
    exit 1
fi

# Handle option 5 early since it relies on ctags instead of cscope
if [ "${1}" == "5" ]; then
    if [ -f "${2}" ]; then
        echo "Listing functions/definitions in file: ${2}"
        # Formats single file output to 'file:line: symbol code'
        ctags -u -x "${2}" | format_ctags | grep --color=always -i -E "${2}|$"
    else
        echo "Searching for files matching '${2}' to list functions..."
        # Formats project recursive output to 'file:line: symbol code'
        ctags -u -R -x . | format_ctags | grep --color=always -i "${2}"
    fi
    exit 0
fi

# Handle option 'a' to directly jump to code using MicroEMACS
if [ "${1}" == "a" ]; then
    echo "Locating definition for '${2}'..."
    MATCH=$(ctags -u -R -x . | grep -i "${2}" | head -n 1)
    if [ -n "$MATCH" ]; then
        LINE=$(echo "$MATCH" | awk '{print $3}')
        FILE=$(echo "$MATCH" | awk '{print $4}')
        echo "Opening $FILE at line $LINE in MicroEMACS..."
        exec "$EDITOR" +"$LINE" "$FILE"
    else
        echo "Error: Symbol '${2}' not found via ctags."
    fi
    exit 1
fi

# Function to search upward from the current directory for a specific file
search_up() {
    local look=${PWD%/}
    while [[ -n $look ]]; do
        [[ -e $look/$1 ]] && { printf '%s\n' "$look"; return; }
        look=${look%/*}
    done
    [[ -e /$1 ]] && echo /
}

# Try to find an existing cscope.out in the current directory or its parent directories
SEARCH=$(search_up "cscope.out")

if [ -n "$SEARCH" ]; then
    TAG_FILE="$SEARCH/cscope.out"
elif [ -f "$HOME/.emacs.d/tags/cscope.out" ]; then
    TAG_FILE="$HOME/.emacs.d/tags/cscope.out"
else
    echo "cscope.out not found anywhere. Generating a new index in the current directory..."
    cscope -bRq
    TAG_FILE="./cscope.out"
fi

echo "Use: $TAG_FILE"

# Execute query, format output to Emacs buffer style, and apply highlighting
cscope -d -f "$TAG_FILE" -R -L${1} ${2} | format_cscope | \
    grep --color=always -i "${2}"
