#!/bin/bash

## Self-contained tig wrapper: embeds its tigrc in a temp file and points
## TIGRC_USER at it, so ~/.tigrc and ~/.tigrc.d are never read. Do not
## point TIGRC_SYSTEM at an empty file: tig then skips its built-in
## default keybindings.
##
## https://github.com/jonas/tig/blob/master/tigrc
## https://jonas.github.io/tig/doc/tigrc.5.html

tmpfile=$(mktemp /tmp/tigrc.XXXXXX)
trap 'rm -f "$tmpfile"' 0 1 2 15
cat > "$tmpfile" <<'EOF'
## common: UI and view settings

set vertical-split = false
set refresh-mode = auto
set ignore-case = true
set mouse = false

set main-view = line-number:no,interval=5 author:no date:no id:yes commit-title:yes,graph,refs,overflow=no
set tree-view = line-number:no,interval=5 mode file-size:units author:no date:relative id:no file-name
set refs-view = line-number:no,interval=5 date:no author:no ref id:yes commit-title
set stash-view = line-number:no,interval=5 date:no author:no id:yes commit-title
set blame-view = id:yes author:full date:relative line-number:yes,interval=1 text

set pager-view = line-number:no,interval=5 text
set stage-view = line-number:no,interval=5 text
set log-view = line-number:no,interval=5 text
set blob-view = line-number:no,interval=5 text
set diff-view = line-number:no,interval=5 text:yes,commit-title-overflow=no

## color: color area fgcolor bgcolor [attributes]

color default                       default     default         normal
color cursor                        default     237
color status                        250         default
color title-focus                   default     238
color title-blur                    default     238
color delimiter                     241         default
color header                        186         236             bold
color section                       186         default
color line-number                   102         235
color id                            208         default
color date                          67          default
color author                        135         default
color mode                          166         default
color overflow                      241         default
color directory                     69          default
color file                          default     default
color file-size                     default     default
color grep.file                     166         234

color graph-commit                  161         default
color main-head                     144         default         bold
color main-remote                   81          default
color main-tracked                  222         default
color main-tag                      197         default
color main-local-tag                161         default
color main-ref                      144         default

color palette-0                     239         default
color palette-1                     242         default
color palette-2                     245         default
color palette-3                     248         default
color palette-4                     237         default
color palette-5                     240         default
color palette-6                     243         default
color palette-7                     246         default
color palette-8                     249         default
color palette-9                     238         default
color palette-10                    241         default
color palette-11                    244         default
color palette-12                    247         default
color palette-13                    236         default

color status.header                 186         236             bold
color status.section                186         default
color stat-staged                   green       default
color stat-unstaged                 red         default
color stat-untracked                red         default

color help.header                   186         236             bold
color help.section                  186         default
color help-group                    69          default
color help-action                   166         default

color "commit "                     208         234
color "Refs: "                      197         234
color "Author: "                    135         default
color "AuthorDate: "                67          default
color "Commit: "                    141         default
color "CommitDate: "                67          default
color "Merge: "                     161         default
color "---"                         67          default
color diff-index                    67          default
color diff-stat                     166         234
color diff-add-highlight            10          22
color diff-del-highlight            9           52

color "gpg: "                       23          default
color "Primary key fingerprint: "   23          default

## key: bindings

## generic move
bind generic V        view-pager
bind generic <Ctrl-s> find-next
bind generic <Ctrl-r> find-prev
bind generic <Ctrl-v> move-page-down
bind generic <Esc>v   move-page-up
bind generic <Ctrl-f> scroll-right
bind generic <Ctrl-b> scroll-left
bind generic <Ctrl-g> refresh

## g move, view-grep view-help
bind generic g        move-first-line
bind generic E        view-grep
bind generic ?        view-help

## G move to tail (default: toggle commit-title-graph)
bind generic G        move-last-line
bind main    G        move-last-line

## Alt-g :toggle commit-title-graph
bind main    <Esc>g   :toggle commit-title-graph

## vertical-split
bind main    <Esc>s   :toggle vertical-split
bind refs    <Esc>s   :toggle vertical-split
bind diff    <Esc>s   :toggle vertical-split

## C commit
bind generic C        !git commit
bind refs    C        !git commit
bind main    C        !git commit
bind generic <Esc>c   !git commit --allow-empty
bind generic +        !git commit --amend --allow-empty
bind status  A        ?git commit --amend --no-edit --reset-author

## F fetch
bind generic F        ?git fetch %(remote)
bind main    F        ?git fetch %(remote)
bind status  F        ?git fetch %(remote)

## U pull
bind generic U        ?git pull %(remote)
bind main    U        ?git pull %(remote)
bind status  U        ?git pull %(remote)

## P push
bind generic P        ?git push %(remote) %(repo:head)
bind main    P        ?git push %(remote) %(repo:head)
bind status  P        ?git push %(remote) %(repo:head)

## ^ reset --soft
bind main    ^        ?git reset --soft %(commit)
bind diff    ^        ?git reset --soft %(commit)
bind refs    ^        ?git reset --soft %(branch)
bind status  ^        ?git reset --soft HEAD

## H reset --hard
bind main    H        ?git reset --hard %(commit)
bind diff    H        ?git reset --hard %(commit)
bind refs    H        ?git reset --hard %(branch)
bind status  H        ?git reset --hard HEAD

## Alt-D delete/rm/drop
bind refs    <Esc>D   ?git branch -d %(branch)
bind status  <Esc>D   ?git clean -d -f -- %(file)
bind stash   <Esc>D   ?git stash drop %(stash)
bind tree    <Esc>D   ?git rm %(file)

## Alt-d difftool
bind main    <Esc>d   ?git difftool %(commit)
bind diff    <Esc>d   ?git difftool %(commit)

## x clean
bind main    x        ?git clean -d -f
bind status  x        ?git clean -d -f

## ! revert
bind main    !        ?git revert %(commit)

## K cherry-pick (default: 'C')
bind main    K        ?git cherry-pick %(commit)
bind diff    K        ?git cherry-pick %(commit)

## Alt-k cherry-pick -n (--no-commit)
bind main    <Esc>k   ?git cherry-pick -n %(commit)
bind diff    <Esc>k   ?git cherry-pick -n %(commit)

## = checkout
bind main    =        ?git checkout %(branch)
bind refs    =        ?git checkout %(branch)
bind main    <Esc>=   ?git checkout %(commit)

## T tag
bind main    T        ?git tag "%(prompt Enter tag name: )" %(commit)
bind refs    T        ?git tag "%(prompt Enter tag name: )" %(branch)

## B checkout -b
bind main    B        ?git checkout -b "%(prompt Enter branch name: )" %(branch)
bind refs    B        ?git checkout -b "%(prompt Enter branch name: )" %(branch)
bind main    <Esc>b   ?git checkout -b "%(prompt Enter branch name: )" %(commit)

## M merge
bind main    M        ?git merge %(branch)
bind diff    M        ?git merge %(branch)
bind refs    M        ?git merge %(branch)
bind main    <Esc>m   ?git merge %(commit)
bind diff    <Esc>m   ?git merge %(commit)

## R rebase
bind main    R        ?git rebase %(branch)
bind diff    R        ?git rebase %(branch)
bind refs    R        ?git rebase %(branch)
bind main    <Esc>r   ?git rebase %(commit)
bind diff    <Esc>r   ?git rebase %(commit)

## I rebase -i
bind main    I        ?git rebase -i %(branch)
bind diff    I        ?git rebase -i %(branch)
bind refs    I        ?git rebase -i %(branch)
bind main    <Esc>i   ?git rebase -i %(commit)
bind diff    <Esc>i   ?git rebase -i %(commit)
EOF
TIGRC_USER="$tmpfile" tig "$@"
ret=$?
rm -f "$tmpfile"
exit $ret
