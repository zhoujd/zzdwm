#!/bin/sh

usage() {
    echo "Usage: abdm [options] [args]"
    echo "Options:"
    echo "  -k <name>    Kill a detached abduco session safely by name"
    echo "  -h, --help   Show this help menu"
    echo ""
    echo "All other options (e.g., -c, -A) are forwarded directly to abduco."
}

abdm() {
    NAME="$1"
    if [ -z "$NAME" ]; then
        usage
        return 1
    fi
    if ! abduco | grep -E "[[:space:]]${NAME}$" >/dev/null 2>&1; then
        echo "Session '$NAME' not found."
        return 1
    fi
    pid=$(abduco | grep -E "[[:space:]]${NAME}$" | awk '{print $5}')
    if [ -n "$pid" ]; then
        echo "Killing session $NAME (PID: $pid)..."
        kill -15 "$pid" 2>/dev/null || kill -9 "$pid" 2>/dev/null
        echo "Session terminated."
        abduco >/dev/null 2>&1
    else
        echo "Could not find an active background process for session $NAME."
    fi
}

case $1 in
    -k )
        shift
        abdm "$@"
        ;;
    -h|--help )
        usage
        ;;
    * )
        abduco "$@"
        ;;
esac
