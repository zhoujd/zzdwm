#!/bin/sh

usage() {
    echo "Usage: abdm [options] [args]"
    echo "Options:"
    echo "  -k <name>    Kill a detached abduco session safely by name"
    echo "  -h, --help   Show this help menu"
    echo ""
    echo "All other options (e.g., -c, -A) are forwarded directly to abduco."
}

abduco() {
    if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
        usage
        return 0
    fi

    if [ "$1" = "-k" ] && [ -n "$2" ]; then
        if [ "$ABDUCO_SESSION" = "$2" ]; then
            echo "Error: Safety lock triggered! You are inside session '$2'."
            echo "To exit cleanly, please type 'exit' or press Ctrl+D instead."
            return 1
        fi

        if ! command abduco | grep -E "[[:space:]]$2$" >/dev/null 2>&1; then
            echo "Session '$2' not found."
            return 1
        fi

        MY_PID=$$
        pid=$(ps -u "$USER" -o pid,args | grep -v "grep" | grep -v "abdm" | \
              grep -v "$MY_PID" | grep -E "abduco.*[[:space:]]$2([[:space:]]|$)" | \
              awk '{print $1}' | head -n 1)

        if [ -n "$pid" ] && [ "$pid" != "$MY_PID" ]; then
            echo "Killing session $2 (PID: $pid)..."
            kill -15 "$pid" 2>/dev/null || kill -9 "$pid" 2>/dev/null
            echo "Session terminated."
            command abduco >/dev/null 2>&1
        else
            echo "Could not find an active background process for session '$2'."
        fi
    else
        command abduco "$@"
    fi
}

abduco "$@"
